# Streamlit Community Cloud Secrets Template (TOML)
# Copy these keys into App Settings -> Secrets (or local .streamlit/secrets.toml, which is gitignored).
# Never commit real API keys to the repository.

PSI_READONLY_MODE = "1"

# Optional Google Gemini API (Google AI Studio)
# GEMINI_API_KEY = "AIza..."
# GEMINI_MODEL = "gemini-2.5-flash"

# Optional OpenAI-compatible RAG / VLM fallback endpoints
# RAG_BASE_URL = "https://api.openai.com/v1"
# RAG_MODEL = ""
# RAG_API_KEY = ""
# VLM_BASE_URL = "https://api.openai.com/v1"
# VLM_MODEL = ""
# VLM_API_KEY = ""
