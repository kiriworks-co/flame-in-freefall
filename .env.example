# Optional Google Gemini API (official free tier supported; offline NASA retrieval works with no key).
# Local user uploads without public NASA provenance are never sent to external AI endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible endpoint (only needed if not using Gemini above).
RAG_BASE_URL=https://api.openai.com/v1
RAG_MODEL=
RAG_API_KEY=
# Path to an already downloaded multilingual sentence-transformers model.
RAG_EMBEDDING_MODEL=

# Optional visual review. Remote page image is sent only after explicit action.
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=
VLM_API_KEY=

